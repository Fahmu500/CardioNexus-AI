# Security - Generate a strong password:
#   python -c "import secrets; print(secrets.token_hex(32))"
CARDIONEXUS_KEY_PASSWORD=change_this_to_a_strong_random_password

# Development Settings
DEBUG=false
LOG_LEVEL=INFO
